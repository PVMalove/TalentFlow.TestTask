{
  "ConnectionStrings": {
    "DbConnection": "",
    "LokiLogsUrl": "http://localhost:3100"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "OpenTelemetry": {
    "Metrics": {
      "AspNetCoreInstrumentation": {
        "RecordException": true
      }
    }
  },
  "AllowedHosts": "*"
}
